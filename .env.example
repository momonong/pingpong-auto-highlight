# 複製成 .env 後再修改；.env 內可能有密碼，絕對不要提交到 Git 或包進 image。

# 只有使用 compose.deploy.yaml 時才會讀取。正式環境請換成 CI 發佈後的固定
# tag；更建議使用 registry 回傳的 immutable digest（image@sha256:...），不要用 latest。
# 帳號功能需等新 release 發佈後，將其完整 tag/digest 貼在等號後；刻意不預填 latest。
PINGPONG_IMAGE=

# 部署主機上的持久資料位置。正式機可換成絕對路徑；不要放在 image/container 裡。
PINGPONG_DATA_PATH=./data

# 瀏覽器連到這台主機時使用的連接埠與基底網址。
PINGPONG_PORT=8000
PINGPONG_PUBLIC_URL=http://192.168.1.19:8000

# 第一次啟動空資料庫時建立管理員。若 PASSWORD 留空，系統會產生隨機密碼並只存到
# PINGPONG_DATA_PATH/.admin-password；設定完成後，請從介面更換密碼並移除 .env 裡的明文。
PINGPONG_BOOTSTRAP_ADMIN_USERNAME=admin
PINGPONG_BOOTSTRAP_ADMIN_PASSWORD=

# 登入 session 預設保留 7 天。只有整條對外路徑都是 HTTPS 時才能設為 true；
# localhost / 純 HTTP LAN 必須維持 false，否則瀏覽器不會送出登入 cookie。
PINGPONG_SESSION_TTL_SECONDS=604800
PINGPONG_SESSION_COOKIE_SECURE=false
# 由 tunnel Compose overlay 自動設定；直接 LAN/localhost 部署不要自行信任 forwarded headers。
PINGPONG_TRUSTED_PROXY_PROVIDER=none

# 舊版 upload token 預設完全不接受。若必須短期支援舊 client，才顯式開啟
# 相容模式；它只可存取 bootstrap 管理員名下
# 的舊資料，不能管理帳號或讀取其他使用者資料。完成遷移後請維持 false。
# PINGPONG_UPLOAD_TOKEN=
PINGPONG_ENABLE_LEGACY_TOKEN_AUTH=false

# 大檔上傳與分析資源。bytes 數值要依部署磁碟與記憶體調整；試用期間建議先把
# MAX_UPLOAD_BYTES 設成實際需要的上限，不要讓單一誤選檔案吃滿資料磁碟。
PINGPONG_MAX_UPLOAD_BYTES=107374182400
PINGPONG_MAX_CHUNK_BYTES=33554432
PINGPONG_VIDEO_SAMPLE_FPS=8
PINGPONG_ANALYSIS_FRAME_SIZE=320
PINGPONG_AUDIO_SAMPLE_RATE=16000
PINGPONG_WORKERS=1

# 每支影片只收進接近該片最佳候選的回合；0 表示不另設球數上限。
PINGPONG_MIN_POINT_SCORE_RATIO=0.87
PINGPONG_MAX_POINTS=0
PINGPONG_REEL_TARGET_SECONDS=55
PINGPONG_CLIP_PRE_ROLL_SECONDS=1.5
PINGPONG_CLIP_POST_ROLL_SECONDS=1.5

# 從 Google Drive 匯入時，電腦至少保留 2 GiB 可用空間。
PINGPONG_DOWNLOAD_MIN_FREE_BYTES=2147483648
