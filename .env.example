# 手機要能開啟的電腦網址。請換成目前電腦在 Wi-Fi 裡的 IP。
PINGPONG_PUBLIC_URL=http://192.168.1.19:8000

# 瀏覽器連到電腦時使用的連接埠。
PINGPONG_PORT=8000

# 每支影片最多收進集錦的得分數、目標長度，以及每球前後留白。
PINGPONG_MAX_POINTS=6
PINGPONG_REEL_TARGET_SECONDS=55
PINGPONG_CLIP_PRE_ROLL_SECONDS=1.5
PINGPONG_CLIP_POST_ROLL_SECONDS=1.5

# 從 Google Drive 匯入時，電腦至少保留 2 GiB 可用空間。
PINGPONG_DOWNLOAD_MIN_FREE_BYTES=2147483648
